;
; Archivo de zona de resolución inversa: /etc/bind/db.inversa
;
$TTL    604800
@   IN  SOA servidor1.asir.com. root.asir.com. (
                2       ; Serial
                604800  ; Refresh
                86400   ; Retry
                2419200 ; Expire
                604800 ); Negative Cache TTL
;
; Servidores de nombres (NS)
@   IN  NS  servidor1.asir.com.
@   IN  NS  servidor2.asir.com.

; Registros PTR (IP -> Nombre)
2   IN  PTR servidor1.asir.com.
3   IN  PTR servidor2.asir.com.
11  IN  PTR cliente.asir.com.