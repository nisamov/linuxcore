// Configuración de servidor principal

//include "/etc/bind/zones.rfc1918";
//ruta /etc/bind/named.conf.local
zone "asir.com" {
    type master;
    file "/etc/bind/db.directa";
    allow-query { any };
    allow-transfer { 192.168.1.3; };
    also-notify { 192.168.1.3; };
};
zone "192.168.in-addr-arpa" {
    type master;
    file "/etc/bind/db.inversa";
    allow-query { any; };
    allow-transfer { 192.168.1.3; };
};