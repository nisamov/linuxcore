// Configuración de zonas en el servidor maestro (servidor1)
// /etc/bind/named.conf.local

zone "asir.com" {
    type master;
    file "/etc/bind/db.directa";
    allow-query { any; };
    allow-transfer { 192.168.1.3; };
    also-notify { 192.168.1.3; };
};

zone "1.168.192.in-addr.arpa" {
    type master;
    file "/etc/bind/db.inversa";
    allow-query { any; };
    allow-transfer { 192.168.1.3; };
    also-notify { 192.168.1.3; };
};