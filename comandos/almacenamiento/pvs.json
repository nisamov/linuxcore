{
  "id": "pvs",
  "nombre": "pvs",
  "descripcion": "Muestra informacion formateada sobre volumenes fisicos (PVs) en el sistema, incluyendo su tamano, uso, atributos y mas.",
  "clasificacion": {
    "categoria": "almacenamiento",
    "subcategoria": "general",
    "tags": [
      "almacenamiento",
      "linea_de_comandos"
    ]
  },
  "sintaxis": {
    "principal": "pvs [opciones] [PV|Tag...]",
    "alternativas": []
  },
  "parametros": [
    {
      "flag": "-a",
      "argumento": null,
      "tipo": "boolean",
      "requerido": false,
      "default": null,
      "valores": [],
      "descripcion": "Muestra informacion sobre dispositivos que no han sido inicializados por LVM, es decir, que no son PVs.",
      "conflictos": [],
      "requiere": []
    },
    {
      "flag": "-A",
      "argumento": null,
      "tipo": "boolean",
      "requerido": false,
      "default": null,
      "valores": [],
      "descripcion": "Muestra informacion sobre PVs fuera del archivo de dispositivos. Combinalo con -a|--all para incluir dispositivos que no son PVs.",
      "conflictos": [],
      "requiere": []
    },
    {
      "flag": "-o",
      "argumento": "String",
      "tipo": "string",
      "requerido": false,
      "default": null,
      "valores": [],
      "descripcion": "Lista ordenada y separada por comas de las columnas a mostrar. Precede la lista con '+' para anadir a la seleccion predeterminada. Usa -o help para ver la lista completa de columnas disponibles.",
      "conflictos": [],
      "requiere": []
    },
    {
      "flag": "-O",
      "argumento": "String",
      "tipo": "string",
      "requerido": false,
      "default": null,
      "valores": [],
      "descripcion": "Lista ordenada y separada por comas de columnas por las que ordenar. Reemplaza la seleccion predeterminada. Precede cualquier columna con '-' para orden inverso.",
      "conflictos": [],
      "requiere": []
    },
    {
      "flag": "-S",
      "argumento": "String",
      "tipo": "string",
      "requerido": false,
      "default": null,
      "valores": [],
      "descripcion": "Selecciona informes para PVs que coincidan con los criterios de seleccion.",
      "conflictos": [],
      "requiere": []
    },
