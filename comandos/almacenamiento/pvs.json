  "ejemplos": [
    {
      "uso": "pvs",
      "explicacion": "Muestra informacion basica sobre todos los volumenes fisicos."
    },
    {
      "uso": "pvs -a",
      "explicacion": "Muestra informacion incluyendo dispositivos que no son PVs."
    },
    {
      "uso": "pvs -o pv_name,pv_size,pv_used",
      "explicacion": "Muestra solo el nombre, tamano y espacio usado de los PVs."
    },
    {
      "uso": "pvs --segments",
      "explicacion": "Muestra una linea por cada segmento contiguo de espacio en cada PV."
    },
    {
      "uso": "pvs --noheadings --units g",
      "explicacion": "Muestra los PVs sin encabezados y con tamanos en gigabytes."
    },
