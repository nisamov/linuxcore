      "argumento": null,
      "tipo": "boolean",
      "requerido": false,
      "default": null,
      "valores": [],
      "descripcion": "Produce una linea de salida para cada asignacion contigua de espacio en cada Volumen Fisico, mostrando el inicio (pvseg_start) y la longitud (pvseg_size) en unidades de extensiones fisicas.",
      "conflictos": [],
      "requiere": []
    },
    {
      "flag": "--aligned",
      "argumento": null,
      "tipo": "boolean",
      "requerido": false,
      "default": null,
      "valores": [],
      "descripcion": "Usar con --separator para alinear las columnas de salida.",
      "conflictos": [],
      "requiere": []
    },
    {
      "flag": "--binary",
      "argumento": null,
      "tipo": "boolean",
      "requerido": false,
      "default": null,
      "valores": [],
      "descripcion": "Usa valores binarios '0' o '1' en lugar de valores literales descriptivos para columnas que tienen exactamente dos valores validos.",
      "conflictos": [],
      "requiere": []
